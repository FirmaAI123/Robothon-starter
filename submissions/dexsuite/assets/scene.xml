<mujoco model="dexsuite_scene">
  <!-- LEAP right hand on a 6-DOF actuated wrist (compiler + option live here) -->
  <include file="leap_hand/leap_rh_wrist.xml"/>

  <statistic center="0 0 0.35" extent="1.0"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-22" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <map force="0.005"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.6 0.78" rgb2="0.05 0.07 0.12"
      width="512" height="3072"/>
    <texture type="2d" name="floortex" builtin="checker" mark="edge" rgb1="0.16 0.18 0.22"
      rgb2="0.10 0.11 0.14" markrgb="0.55 0.6 0.7" width="300" height="300"/>
    <material name="floormat" texture="floortex" texuniform="true" texrepeat="6 6" reflectance="0.12"/>
    <material name="tabletop" rgba="0.83 0.78 0.66 1" reflectance="0.05"/>
    <material name="tableleg" rgba="0.32 0.26 0.20 1"/>
    <material name="cubemat" rgba="0.86 0.25 0.22 1"/>
    <material name="ballmat" rgba="0.22 0.55 0.86 1"/>
    <material name="bin1mat" rgba="0.86 0.30 0.26 0.45"/>
    <material name="bin2mat" rgba="0.26 0.58 0.86 0.45"/>
    <material name="btn_base" rgba="0.20 0.20 0.24 1"/>
    <material name="btn_cap" rgba="0.95 0.80 0.10 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.4 0.2 1.3" dir="-0.3 -0.15 -1" directional="false"
      diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-0.5 -0.4 1.1" dir="0.4 0.3 -1" directional="false"
      diffuse="0.35 0.35 0.4"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="floormat" pos="0 0 0"/>

    <!-- table: top surface at z = 0.40 -->
    <body name="table" pos="0 0 0">
      <geom name="table_top" type="box" size="0.40 0.36 0.02" pos="0 0 0.38"
        material="tabletop" friction="0.9 0.02 0.001"/>
      <geom name="leg1" type="box" size="0.02 0.02 0.19" pos="0.36 0.32 0.19" material="tableleg"/>
      <geom name="leg2" type="box" size="0.02 0.02 0.19" pos="-0.36 0.32 0.19" material="tableleg"/>
      <geom name="leg3" type="box" size="0.02 0.02 0.19" pos="0.36 -0.32 0.19" material="tableleg"/>
      <geom name="leg4" type="box" size="0.02 0.02 0.19" pos="-0.36 -0.32 0.19" material="tableleg"/>
    </body>

    <!-- scene camera: front-3/4 view of the workspace -->
    <camera name="scene_cam" pos="0.62 -0.62 0.92" xyaxes="0.7 0.7 0 -0.32 0.32 0.9"/>
    <camera name="front_cam" pos="0.0 -0.85 0.70" xyaxes="1 0 0 0 0.5 0.86"/>

    <!-- pick fixtures: thin pedestals raise parts to manipulator height -->
    <body name="ped1" pos="0.16 0.07 0">
      <geom name="ped1_post" type="cylinder" size="0.012 0.078" pos="0 0 0.478" material="tableleg"/>
      <geom name="ped1_cap" type="cylinder" size="0.02 0.004" pos="0 0 0.56" material="tableleg"/>
    </body>
    <body name="ped2" pos="0.16 -0.07 0">
      <geom name="ped2_post" type="cylinder" size="0.012 0.078" pos="0 0 0.478" material="tableleg"/>
      <geom name="ped2_cap" type="cylinder" size="0.02 0.004" pos="0 0 0.56" material="tableleg"/>
    </body>

    <!-- manipuland 1: cube (rounded box) resting on pedestal 1 -->
    <body name="cube" pos="0.16 0.07 0.594">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.026 0.026 0.026" material="cubemat"
        friction="1.3 0.08 0.004" condim="4" mass="0.045" solimp="0.99 0.995 0.001"/>
    </body>

    <!-- manipuland 2: ball (hand-scaled sphere) resting on pedestal 2 -->
    <body name="ball" pos="0.16 -0.07 0.59">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.032" material="ballmat"
        friction="1.4 0.08 0.004" condim="4" mass="0.045"/>
    </body>

    <!-- target bin 1 (cube): deep open tray -->
    <body name="bin1" pos="-0.24 0.15 0.40">
      <geom name="bin1_floor" type="box" size="0.085 0.085 0.005" pos="0 0 0.005" material="bin1mat"/>
      <geom name="bin1_wxp" type="box" size="0.006 0.085 0.055" pos="0.085 0 0.055" material="bin1mat"/>
      <geom name="bin1_wxn" type="box" size="0.006 0.085 0.055" pos="-0.085 0 0.055" material="bin1mat"/>
      <geom name="bin1_wyp" type="box" size="0.085 0.006 0.055" pos="0 0.085 0.055" material="bin1mat"/>
      <geom name="bin1_wyn" type="box" size="0.085 0.006 0.055" pos="0 -0.085 0.055" material="bin1mat"/>
      <site name="bin1_site" pos="0 0 0.03" size="0.07" rgba="0 0 0 0"/>
    </body>

    <!-- target bin 2 (ball): deep open tray -->
    <body name="bin2" pos="-0.24 -0.15 0.40">
      <geom name="bin2_floor" type="box" size="0.085 0.085 0.005" pos="0 0 0.005" material="bin2mat"/>
      <geom name="bin2_wxp" type="box" size="0.006 0.085 0.055" pos="0.085 0 0.055" material="bin2mat"/>
      <geom name="bin2_wxn" type="box" size="0.006 0.085 0.055" pos="-0.085 0 0.055" material="bin2mat"/>
      <geom name="bin2_wyp" type="box" size="0.085 0.006 0.055" pos="0 0.085 0.055" material="bin2mat"/>
      <geom name="bin2_wyn" type="box" size="0.085 0.006 0.055" pos="0 -0.085 0.055" material="bin2mat"/>
      <site name="bin2_site" pos="0 0 0.03" size="0.07" rgba="0 0 0 0"/>
    </body>

    <!-- press button: spring-loaded plunger with real travel clearance -->
    <body name="button" pos="-0.02 0.20 0.40">
      <geom name="btn_base" type="cylinder" size="0.038 0.005" pos="0 0 0.005" material="btn_base"/>
      <geom name="btn_rim" type="cylinder" size="0.030 0.018" pos="0 0 0.018" material="btn_base"/>
      <body name="btn_cap" pos="0 0 0.062">
        <joint name="btn_slide" type="slide" axis="0 0 1" range="-0.030 0.0"
          stiffness="90" damping="2.5" springref="0.0"/>
        <inertial pos="0 0 0" mass="0.015" diaginertia="4e-6 4e-6 4e-6"/>
        <geom name="btn_cap_geom" type="cylinder" size="0.024 0.010" material="btn_cap"
          friction="1.0 0.02 0.001"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <!-- task-state sensing: button depression + manipuland poses -->
    <jointpos name="btn_pos" joint="btn_slide"/>
    <framepos name="cube_pos" objtype="body" objname="cube"/>
    <framepos name="ball_pos" objtype="body" objname="ball"/>
  </sensor>
</mujoco>
