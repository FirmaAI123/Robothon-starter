<mujoco model="panda_stack">
  <!-- Franka Panda + a table, three free cubes to stack, and a stack-base marker.
       Includes the vendored panda.xml (compiler/meshdir live there); model untouched. -->
  <include file="panda.xml"/>
  <statistic center="0.45 0 0.45" extent="1.1"/>
  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-24" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.6 0.78" rgb2="0.05 0.07 0.12" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.16 0.18 0.22" rgb2="0.10 0.11 0.14" markrgb="0.5 0.55 0.65" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="6 6" reflectance="0.1"/>
    <material name="table" rgba="0.45 0.37 0.28 1"/>
    <material name="c1" rgba="0.90 0.36 0.30 1"/>
    <material name="c2" rgba="0.35 0.75 0.45 1"/>
    <material name="c3" rgba="0.35 0.55 0.92 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.5 -0.6 2.2" dir="-0.1 0.2 -1" diffuse="0.85 0.85 0.85" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="0.2 0.8 1.6" dir="0.1 -0.4 -1" diffuse="0.3 0.3 0.35"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>
    <geom name="table" type="box" pos="0.5 0 0.2" size="0.35 0.45 0.2" material="table" friction="1 .01 .001"/>

    <!-- stack base marker (visual only) -->
    <geom name="base_marker" type="cylinder" size="0.05 0.001" pos="0.48 0.0 0.401"
      rgba="0.95 0.85 0.30 0.5" contype="0" conaffinity="0"/>

    <!-- three free cubes (5 cm) to be stacked -->
    <body name="cube1" pos="0.40 0.15 0.425">
      <freejoint/>
      <geom name="cube1" type="box" size="0.025 0.025 0.025" mass="0.05" material="c1"
        friction="1.4 .02 .001" condim="4" solref="0.01 1"/>
    </body>
    <body name="cube2" pos="0.57 0.10 0.425">
      <freejoint/>
      <geom name="cube2" type="box" size="0.025 0.025 0.025" mass="0.05" material="c2"
        friction="1.4 .02 .001" condim="4" solref="0.01 1"/>
    </body>
    <body name="cube3" pos="0.43 -0.15 0.425">
      <freejoint/>
      <geom name="cube3" type="box" size="0.025 0.025 0.025" mass="0.05" material="c3"
        friction="1.4 .02 .001" condim="4" solref="0.01 1"/>
    </body>

    <camera name="track_cam" pos="1.05 -0.95 0.95" xyaxes="0.7 0.72 0 -0.28 0.27 0.92"/>
    <camera name="front_cam" pos="1.25 0 0.7" xyaxes="0 1 0 -0.4 0 0.9"/>
  </worldbody>
</mujoco>
