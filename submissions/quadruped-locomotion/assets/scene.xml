<mujoco model="quadloco_scene">
  <!-- Unitree Go2 (BSD-3, vendored). compiler + actuators + keyframe live in go2.xml -->
  <include file="go2/go2.xml"/>

  <statistic center="0 0 0.2" extent="1.2"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-18" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.6 0.78" rgb2="0.05 0.07 0.12"
      width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.14 0.16 0.20"
      rgb2="0.09 0.10 0.13" markrgb="0.5 0.55 0.65" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="8 8" reflectance="0.12"/>
    <material name="terr" rgba="0.36 0.30 0.24 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="key" pos="2.0 -1.0 3.0" dir="-0.4 0.2 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-1.0 1.0 2.0" dir="0.3 -0.3 -1" diffuse="0.3 0.3 0.35"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid" friction="1.0 0.02 0.001"/>

    <!-- terrain course along +x: gentle ramp, a field of bumps, a low step.
         The open-loop CPG trot traverses it without terrain feedback. -->
    <geom name="ramp" type="box" size="0.5 0.6 0.03" pos="1.2 0 0.0" euler="0 -0.12 0"
      material="terr" friction="1.0 0.02 0.001"/>
    <geom name="bump1" type="box" size="0.06 0.6 0.012" pos="2.1 0 0.012" material="terr"/>
    <geom name="bump2" type="box" size="0.06 0.6 0.015" pos="2.5 0 0.015" material="terr"/>
    <geom name="bump3" type="box" size="0.06 0.6 0.012" pos="2.9 0 0.012" material="terr"/>
    <geom name="step" type="box" size="0.4 0.6 0.025" pos="3.6 0 0.025" material="terr"/>

    <!-- cameras: a tracking close-up that follows the robot, plus a wide scene view -->
    <camera name="track_cam" mode="targetbody" target="base" pos="1.4 -1.6 0.9"/>
    <camera name="scene_cam" pos="2.2 -2.2 1.3" xyaxes="0.7 0.7 0 -0.3 0.3 0.9"/>
  </worldbody>

  <sensor>
    <!-- trunk IMU: orientation, angular rate, linear acceleration, body velocity -->
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
    <velocimeter name="imu_vel" site="imu"/>
    <framepos name="base_pos" objtype="site" objname="imu"/>
  </sensor>
</mujoco>
