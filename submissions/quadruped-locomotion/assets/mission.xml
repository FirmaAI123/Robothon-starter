<mujoco model="quadloco_mission">
  <!-- Flat scene with three visible (non-colliding) goal markers, for the autonomous
       go-to-goal mission demo. Same Go2 + IMU sensors as scene.xml; go2.xml untouched. -->
  <include file="go2/go2.xml"/>
  <option timestep="0.002"/>
  <statistic center="1.5 0 0.2" extent="3.0"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-30" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.6 0.78" rgb2="0.05 0.07 0.12" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.14 0.16 0.20" rgb2="0.09 0.10 0.13" markrgb="0.5 0.55 0.65" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="8 8" reflectance="0.12"/>
    <material name="g1" rgba="0.30 0.80 0.45 0.85"/>
    <material name="g2" rgba="0.95 0.55 0.20 0.85"/>
    <material name="g3" rgba="0.35 0.55 0.95 0.85"/>
  </asset>

  <worldbody>
    <light name="key" pos="2.0 -1.0 3.0" dir="-0.4 0.2 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-1.0 1.0 2.0" dir="0.3 -0.3 -1" diffuse="0.3 0.3 0.35"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid" friction="1.0 0.02 0.001"/>

    <!-- goal markers (visual only: no collision) at the 3 mission waypoints -->
    <geom name="goal1" type="cylinder" size="0.18 0.004" pos="2.5 1.2 0.004" material="g1" contype="0" conaffinity="0"/>
    <geom name="goal2" type="cylinder" size="0.18 0.004" pos="4.0 -1.0 0.004" material="g2" contype="0" conaffinity="0"/>
    <geom name="goal3" type="cylinder" size="0.18 0.004" pos="0.3 0.0 0.004" material="g3" contype="0" conaffinity="0"/>

    <camera name="track_cam" mode="targetbody" target="base" pos="2.0 -2.4 1.4"/>
    <camera name="scene_cam" pos="2.0 -3.4 2.6" xyaxes="1 0 0 0 0.7 0.7"/>
  </worldbody>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
    <velocimeter name="imu_vel" site="imu"/>
    <framepos name="base_pos" objtype="site" objname="imu"/>
  </sensor>
</mujoco>
