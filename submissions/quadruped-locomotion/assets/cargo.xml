<mujoco model="quadloco_cargo">
  <!-- Loco-manipulation scene: the Go2 carries a free payload on a tray welded to its
       trunk across the terrain course. The closed-loop terrain-leveling keeps the trunk
       (hence the tray) level so the cargo rides safely. Tray + payload are free bodies;
       go2.xml stays unmodified. -->
  <include file="go2/go2.xml"/>
  <option timestep="0.002"/>
  <statistic center="0 0 0.2" extent="1.2"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-18" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.6 0.78" rgb2="0.05 0.07 0.12" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.14 0.16 0.20" rgb2="0.09 0.10 0.13" markrgb="0.5 0.55 0.65" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="8 8" reflectance="0.12"/>
    <material name="terr" rgba="0.36 0.30 0.24 1" reflectance="0.05"/>
    <material name="cargo" rgba="0.95 0.55 0.2 1"/>
    <material name="tray" rgba="0.25 0.5 0.85 1"/>
    <hfield name="rough" nrow="60" ncol="120" size="0.9 0.7 0.03 0.1"/>
  </asset>

  <worldbody>
    <light name="key" pos="2.0 -1.0 3.0" dir="-0.4 0.2 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-1.0 1.0 2.0" dir="0.3 -0.3 -1" diffuse="0.3 0.3 0.35"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid" friction="1.0 0.02 0.001"/>

    <geom name="ramp" type="box" size="0.45 0.6 0.03" pos="1.0 0 0.0" euler="0 -0.12 0" material="terr" friction="1.0 0.02 0.001"/>
    <geom name="rough" type="hfield" hfield="rough" pos="2.6 0 0.0" material="terr" friction="1.0 0.02 0.001"/>
    <geom name="step" type="box" size="0.35 0.6 0.025" pos="4.0 0 0.025" material="terr"/>

    <!-- cargo tray, welded rigidly to the trunk (sits on the robot's back). A snug
         walled tray + a low-CoM payload keep the cargo stable: it still slides as a
         free body (~3 cm) but is contained, not glued. -->
    <body name="tray" pos="0 0 0.50">
      <freejoint/>
      <geom name="tray_floor" type="box" size="0.075 0.075 0.004" mass="0.15" material="tray"/>
      <geom type="box" size="0.075 0.006 0.03" pos="0 0.075 0.03" mass="0.01" material="tray"/>
      <geom type="box" size="0.075 0.006 0.03" pos="0 -0.075 0.03" mass="0.01" material="tray"/>
      <geom type="box" size="0.006 0.075 0.03" pos="0.075 0 0.03" mass="0.01" material="tray"/>
      <geom type="box" size="0.006 0.075 0.03" pos="-0.075 0 0.03" mass="0.01" material="tray"/>
    </body>

    <!-- free, low-CoM payload box resting on the tray -->
    <body name="payload" pos="0 0 0.55">
      <freejoint/>
      <geom name="payload" type="box" size="0.05 0.05 0.025" mass="0.45" material="cargo"
        friction="0.9 0.02 0.001"/>
    </body>

    <camera name="track_cam" mode="targetbody" target="base" pos="1.4 -1.6 0.9"/>
    <camera name="scene_cam" pos="2.2 -2.2 1.3" xyaxes="0.7 0.7 0 -0.3 0.3 0.9"/>
  </worldbody>

  <equality>
    <!-- tray rides 0.055 m above the trunk origin (on the robot's back), rigidly -->
    <weld body1="base" body2="tray" relpose="0 0 0.055 1 0 0 0" solref="0.005 1"/>
  </equality>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
    <velocimeter name="imu_vel" site="imu"/>
    <framepos name="base_pos" objtype="site" objname="imu"/>
  </sensor>
</mujoco>
